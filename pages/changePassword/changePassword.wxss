.container {
  min-height: 100vh;
  padding: 30rpx;
  background-color: var(--bg-color);
}

.card {
  background-color: var(--card-bg);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.form-card {
  padding: 40rpx 30rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  background-color: var(--bg-color);
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 92rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  padding-right: 64rpx;
}

.password-toggle {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.eye-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.7;
}

.password-tip {
  margin-bottom: 40rpx;
  padding: 20rpx 24rpx;
  background-color: #f0f7ff;
  border-radius: 8rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #0052d9;
  line-height: 1.6;
}

.btn {
  border-radius: 12rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.btn-primary {
  background-color: var(--primary-color);
  color: #ffffff;
}

.btn-primary[disabled] {
  opacity: 0.6;
}

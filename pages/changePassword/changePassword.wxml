<view class="container" data-theme="{{theme}}">
  <view class="form-card card">
    <view class="form-item">
      <view class="label">原密码</view>
      <view class="input-wrapper">
        <input
          class="input"
          password="{{!showOldPassword}}"
          placeholder="请输入原密码"
          value="{{oldPassword}}"
          bindinput="onOldPasswordInput"
        />
        <view class="password-toggle" catchtap="toggleOldPassword">
          <image
            class="eye-icon"
            src="{{showOldPassword ? '/assets/closes-eyes.png' : '/assets/eyes.png'}}"
            mode="aspectFit"
          />
        </view>
      </view>
    </view>

    <view class="form-item">
      <view class="label">新密码</view>
      <view class="input-wrapper">
        <input
          class="input"
          password="{{!showNewPassword}}"
          placeholder="请输入新密码"
          value="{{newPassword}}"
          bindinput="onNewPasswordInput"
        />
        <view class="password-toggle" catchtap="toggleNewPassword">
          <image
            class="eye-icon"
            src="{{showNewPassword ? '/assets/closes-eyes.png' : '/assets/eyes.png'}}"
            mode="aspectFit"
          />
        </view>
      </view>
    </view>

    <view class="form-item">
      <view class="label">确认新密码</view>
      <view class="input-wrapper">
        <input
          class="input"
          password="{{!showConfirmPassword}}"
          placeholder="请再次输入新密码"
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
        />
        <view class="password-toggle" catchtap="toggleConfirmPassword">
          <image
            class="eye-icon"
            src="{{showConfirmPassword ? '/assets/closes-eyes.png' : '/assets/eyes.png'}}"
            mode="aspectFit"
          />
        </view>
      </view>
    </view>

    <view class="password-tip">
      <text class="tip-text">密码要求：至少8位，包含大小写字母及特殊字符</text>
    </view>

    <button
      class="btn btn-primary"
      bindtap="handleSubmit"
      disabled="{{loading}}"
    >
      {{loading ? '提交中...' : '确认修改'}}
    </button>
  </view>
</view>

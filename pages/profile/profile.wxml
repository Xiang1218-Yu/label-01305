<view class="container" data-theme="{{theme}}">
  <view class="user-card card">
    <image class="avatar" src="/assets/default-avatar.png" mode="aspectFill" wx:if="{{false}}"></image> 
    <!-- Use a simple view for avatar placeholder -->
    <view class="avatar-placeholder">{{username[0]}}</view>
    <view class="username">{{username}}</view>
  </view>

  <view class="menu-list card">
    <view class="menu-item">
      <view class="menu-label">护眼模式</view>
      <switch checked="{{theme === 'eye-protect'}}" bindchange="toggleTheme" color="var(--primary-color)" />
    </view>
    <view class="menu-item" bindtap="exportTasks">
      <view class="menu-label">导出任务</view>
      <icon type="download" size="16" color="#999" />
    </view>
    <view class="menu-item" bindtap="clearCompleted">
      <view class="menu-label">清理已完成</view>
      <icon type="clear" size="16" color="#999" />
    </view>
  </view>
  
  <!-- 完成率卡片 -->
  <view class="completion-card card">
    <view class="completion-header">
      <view class="completion-title">任务完成率</view>
      <view class="completion-percent">{{totalTasks > 0 ? completionRate : 0}}%</view>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{completionRate}}%"></view>
    </view>
    <view class="completion-desc">
      <text>已完成 {{completedTasks}} / {{totalTasks}} 个任务</text>
      <text wx:if="{{totalTasks === 0}}" class="no-task-hint">（暂无任务）</text>
    </view>
  </view>

  <view class="stats-grid">
     <view class="stat-card card">
        <view class="stat-num">{{totalTasks}}</view>
        <view class="stat-label">总数</view>
     </view>
     <view class="stat-card card">
        <view class="stat-num">{{completedTasks}}</view>
        <view class="stat-label">已完成</view>
     </view>
     <view class="stat-card card">
        <view class="stat-num">{{pendingTasks}}</view>
        <view class="stat-label">待办</view>
     </view>
     <view class="stat-card card stat-warning">
        <view class="stat-num">{{overdueTasks}}</view>
        <view class="stat-label">已逾期</view>
     </view>
     <view class="stat-card card stat-info">
        <view class="stat-num">{{dueSoonTasks}}</view>
        <view class="stat-label">即将到期</view>
     </view>
  </view>

  <view class="action-area">
    <button class="btn btn-danger" bindtap="handleLogout">退出登录</button>
  </view>
</view>

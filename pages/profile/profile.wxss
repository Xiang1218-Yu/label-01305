.user-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32px;
}

.avatar-placeholder {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: var(--primary-color);
  color: #fff;
  font-size: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
  text-transform: uppercase;
}

.username {
  font-size: 20px;
  font-weight: bold;
}

.menu-list {
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px;
  border-bottom: 1px solid var(--border-color);
}

.menu-item:last-child {
  border-bottom: none;
}

.completion-card {
    margin-bottom: 16px;
    padding: 20px;
}

.completion-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.completion-title {
    font-size: 16px;
    font-weight: 500;
    color: var(--text-main);
}

.completion-percent {
    font-size: 24px;
    font-weight: bold;
    color: var(--primary-color);
}

.progress-bar {
    width: 100%;
    height: 12px;
    background: var(--bg-color);
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 8px;
    border: 1px solid var(--border-color);
}

.progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary-color) 0%, rgba(0, 82, 217, 0.8) 100%);
    border-radius: 6px;
    transition: width 0.5s ease;
    box-shadow: 0 2px 4px rgba(0, 82, 217, 0.3);
}

.completion-desc {
    font-size: 12px;
    color: var(--text-sub);
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
}

.no-task-hint {
    color: var(--text-sub);
    opacity: 0.6;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 16px;
}

.stat-card {
    text-align: center;
    padding: 20px;
    margin-bottom: 0;
}

.stat-warning .stat-num {
    color: var(--danger-color);
}

.stat-info .stat-num {
    color: var(--warning-color);
}

.stat-num {
    font-size: 24px;
    font-weight: bold;
    color: var(--primary-color);
    margin-bottom: 4px;
}

.stat-label {
    font-size: 12px;
    color: var(--text-sub);
}

.action-area {
  margin-top: 32px;
}

.auth-card {
  width: 100%;
  max-width: 320px;
  margin: 0 auto;
  padding: 32px 24px;
}

.title {
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 24px;
  text-align: center;
  color: var(--primary-color);
}

.input-group {
  margin-bottom: 20px;
}

.label {
  margin-bottom: 8px;
  font-size: 14px;
  color: var(--text-sub);
}

.input {
  width: 100%;
  height: 44px;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 0 12px;
  font-size: 16px;
  background: var(--bg-color);
  box-sizing: border-box;
}

.actions {
  margin-top: 32px;
}

.switch-mode {
  margin-top: 16px;
  text-align: center;
  color: var(--primary-color);
  font-size: 14px;
}

/* Welcome Section */
.container{
  box-sizing: border-box;
}
.welcome-section {
  margin-bottom: 20px;
}

.welcome-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16px;
}

.welcome-text {
  flex: 1;
}

.greeting {
  font-size: 14px;
  color: var(--text-sub);
  margin-bottom: 4px;
}

.username {
  font-size: 24px;
  font-weight: 600;
  color: var(--text-main);
}

.date-info {
  font-size: 12px;
  color: var(--text-sub);
  padding: 4px 12px;
  background: var(--card-bg);
  border-radius: 12px;
  border: 1px solid var(--border-color);
}

/* Stats Grid */
.stats-grid {
  display: flex;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.stat-card {
  background: var(--card-bg);
  border-radius: 12px;
  padding: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: var(--shadow);
  border: 1px solid var(--border-color);
  transition: all 0.3s ease;
}

.stat-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.stat-pending {
  border-left: 3px solid #0052d9;
}

.stat-completed {
  border-left: 3px solid #2ba471;
}

.stat-overdue {
  border-left: 3px solid #d93025;
}

.stat-icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 82, 217, 0.1);
  flex-shrink: 0;
}

.stat-completed .stat-icon {
  background: rgba(43, 164, 113, 0.1);
}

.stat-overdue .stat-icon {
  background: rgba(217, 48, 37, 0.1);
}

.stat-content {
  flex: 1;
}

.stat-value {
  font-size: 20px;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.2;
  margin-bottom: 2px;
}

.stat-label {
  font-size: 12px;
  color: var(--text-sub);
}

.header-section {
  position: sticky;
  top: 0;
  z-index: 10;
  background-color: var(--bg-color);
  padding-bottom: 8px;
  margin-bottom: 16px;
}

.search-bar {
  display: flex;
  align-items: center;
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 20px;
  padding: 12px 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.search-bar:active {
  box-shadow: 0 2px 12px rgba(0, 82, 217, 0.15);
  border-color: var(--primary-color);
}

.search-input {
  flex: 1;
  margin-left: 8px;
  font-size: 14px;
}

.filter-section {
  margin-bottom: 12px;
}

.filter-tabs {
  display: flex;
  justify-content: space-around;
  margin-bottom: 8px;
}

.filter-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px 12px;
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 16px;
  font-size: 12px;
  color: var(--text-sub);
  transition: all 0.2s;
}

.filter-btn:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.tab {
  padding: 6px 16px;
  border-radius: 16px;
  font-size: 14px;
  color: var(--text-sub);
  background: transparent;
  transition: all 0.3s;
}

.tab.active {
  background: var(--primary-color);
  color: #fff;
  font-weight: 500;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.task-list {
  height: calc(100vh - 280px);
}

.task-card {
  display: flex;
  flex-direction: column;
  border-left: 4px solid var(--primary-color);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.task-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  background: linear-gradient(180deg, var(--primary-color) 0%, rgba(0, 82, 217, 0.6) 100%);
  transition: width 0.3s ease;
}

.task-card:active {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
}

.task-done {
  opacity: 0.6;
  border-left-color: var(--success-color);
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  flex-wrap: wrap;
  gap: 8px;
}

.tag {
  font-size: 11px;
  padding: 4px 10px;
  border-radius: 12px;
  font-weight: 500;
  display: inline-block;
  line-height: 1.2;
}

.tag-priority {
  background: #fff3e0;
  color: #e37318;
}

.tag-high {
  background: #ffebeb;
  color: #d93025;
}

.tag-medium {
  background: #fff3e0;
  color: #e37318;
}

.tag-low {
  background: #e6f4ea;
  color: #137333;
}

.tag-type {
  background: #e8f0fe;
  color: #1967d2;
}

.task-body {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.checkbox {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 2px solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  flex-shrink: 0;
  cursor: pointer;
  background: var(--card-bg);
}

.checkbox:active {
  transform: scale(1.1);
}

.checkbox.checked {
  background: var(--success-color);
  border-color: var(--success-color);
}

.task-content {
  flex: 1;
}

.task-title {
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 8px;
  line-height: 1.4;
  color: var(--text-main);
}

.task-done .task-title {
  text-decoration: line-through;
  color: var(--text-sub);
}

.task-date {
  font-size: 12px;
  color: var(--text-sub);
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.task-date text {
  display: inline-block;
}

.overdue-tag {
  color: var(--danger-color);
  font-weight: bold;
  font-size: 10px;
}

.due-soon-tag {
  color: var(--warning-color);
  font-weight: bold;
  font-size: 10px;
}


.fab {
  position: fixed;
  bottom: 24px;
  right: 24px;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-color) 0%, #0066ff 100%);
  box-shadow: 0 6px 20px rgba(0, 82, 217, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  transition: all 0.3s ease;
}

.fab:active {
  transform: scale(0.9);
  box-shadow: 0 4px 12px rgba(0, 82, 217, 0.3);
}

.fab-icon {
  color: #fff;
  font-size: 32px;
  font-weight: 300;
  margin-top: -4px;
  line-height: 1;
}

.empty-state {
  text-align: center;
  padding: 80px 24px;
  color: var(--text-sub);
}

.empty-icon {
  margin-bottom: 16px;
  opacity: 0.5;
}

.empty-text {
  font-size: 18px;
  font-weight: 500;
  color: var(--text-main);
  margin-bottom: 8px;
}

.empty-hint {
  font-size: 14px;
  color: var(--text-sub);
  opacity: 0.8;
}

.spacer-bottom {
  height: 80px; /* Space for FAB */
}

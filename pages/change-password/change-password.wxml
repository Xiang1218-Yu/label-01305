<view class="container flex-col" data-theme="{{theme}}">
  <view class="auth-card card">
    <view class="title">修改密码</view>
    
    <view class="input-group">
      <view class="label">原密码</view>
      <view class="password-input-wrapper">
        <input 
          class="input password-input" 
          password="{{!showOldPassword}}"
          placeholder="请输入原密码" 
          value="{{oldPassword}}"
          bindinput="onOldPasswordInput"
        />
        <view class="password-toggle" catchtap="toggleOldPassword">
          <image 
            class="password-icon" 
            src="{{showOldPassword ? '/assets/closes-eyes.png' : '/assets/eyes.png'}}" 
            mode="aspectFit"
          />
        </view>
      </view>
    </view>
    
    <view class="input-group">
      <view class="label">新密码</view>
      <view class="password-input-wrapper">
        <input 
          class="input password-input" 
          password="{{!showNewPassword}}"
          placeholder="请输入新密码" 
          value="{{newPassword}}"
          bindinput="onNewPasswordInput"
        />
        <view class="password-toggle" catchtap="toggleNewPassword">
          <image 
            class="password-icon" 
            src="{{showNewPassword ? '/assets/closes-eyes.png' : '/assets/eyes.png'}}" 
            mode="aspectFit"
          />
        </view>
      </view>
      <view class="password-hint">密码需包含大小写字母及特殊字符</view>
    </view>
    
    <view class="input-group">
      <view class="label">确认密码</view>
      <view class="password-input-wrapper">
        <input 
          class="input password-input" 
          password="{{!showConfirmPassword}}"
          placeholder="请再次输入新密码" 
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
        />
        <view class="password-toggle" catchtap="toggleConfirmPassword">
          <image 
            class="password-icon" 
            src="{{showConfirmPassword ? '/assets/closes-eyes.png' : '/assets/eyes.png'}}" 
            mode="aspectFit"
          />
        </view>
      </view>
    </view>

    <view class="actions">
      <button class="btn btn-primary" bindtap="handleSubmit" loading="{{loading}}">
        确认修改
      </button>
    </view>
  </view>
</view>

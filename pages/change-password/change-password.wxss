.auth-card {
  width: 100%;
  max-width: 320px;
  margin: 32px auto 0;
  padding: 32px 24px;
}

.title {
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 24px;
  text-align: center;
  color: var(--primary-color);
}

.input-group {
  margin-bottom: 20px;
}

.label {
  margin-bottom: 8px;
  font-size: 14px;
  color: var(--text-sub);
}

.input {
  width: 100%;
  height: 44px;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 0 12px;
  font-size: 16px;
  background: var(--bg-color);
  box-sizing: border-box;
}

.password-input-wrapper {
  position: relative;
  width: 100%;
}

.password-input {
  padding-right: 44px;
}

.password-toggle {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: opacity 0.2s;
  user-select: none;
}

.password-toggle:active {
  opacity: 0.6;
}

.password-icon {
  width: 20px;
  height: 20px;
  opacity: 0.7;
  transition: opacity 0.2s;
}

.password-toggle:active .password-icon {
  opacity: 1;
}

.password-hint {
  margin-top: 6px;
  font-size: 12px;
  color: var(--text-sub);
}

.actions {
  margin-top: 32px;
}

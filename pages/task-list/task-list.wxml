<view class="container" data-theme="{{theme}}">
  <view class="header">
    <view class="filter-label">{{filterLabel}}</view>
    <view class="task-count">共 {{tasks.length}} 个任务</view>
  </view>

  <view class="task-list" wx:if="{{tasks.length > 0}}">
    <view class="task-item card" wx:for="{{tasks}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="task-left">
        <view class="checkbox {{item.status === 'completed' ? 'checked' : ''}}" catchtap="toggleTaskStatus" data-id="{{item.id}}">
          <image wx:if="{{item.status === 'completed'}}" class="check-icon" src="/assets/tabbar/tasks-active.png" mode="aspectFit"></image>
        </view>
        <view class="task-content">
          <view class="task-title {{item.status === 'completed' ? 'completed' : ''}} {{item.isOverdue ? 'overdue' : ''}} {{item.isDueSoon && !item.isOverdue ? 'due-soon' : ''}}">{{item.title}}</view>
          <view class="task-meta">
            <view class="task-date">
              <text class="date-icon">📅</text>
              <text>{{item.endDateTime || item.endDate || '无截止日期'}}</text>
            </view>
            <view class="task-category" wx:if="{{item.category}}">{{item.category}}</view>
          </view>
        </view>
      </view>
      <view class="task-right" catchtap="showActionSheet" data-id="{{item.id}}">
        <text class="more-btn">⋯</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <view class="empty-icon">📝</view>
    <view class="empty-text">暂无任务</view>
  </view>
</view>

.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: var(--bg-color, #f5f5f5);
}

.template-preview {
  background: var(--card-bg, #fff);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.preview-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-color, #333);
  margin-bottom: 20rpx;
}

.preview-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.priority-tag {
  background: #e6f2ff;
  color: #0052d9;
}

.type-tag {
  background: #f0f0f0;
  color: #666;
}

.duration-tag {
  background: #e6f7ed;
  color: #52c41a;
}

.preview-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--border-color, #eee);
}

.time-form {
  background: var(--card-bg, #fff);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color, #333);
  margin-bottom: 30rpx;
}

.time-section {
  margin-bottom: 30rpx;
}

.time-section:last-child {
  margin-bottom: 0;
}

.time-label {
  font-size: 28rpx;
  color: var(--text-color, #333);
  margin-bottom: 16rpx;
}

.time-picker-group {
  display: flex;
  gap: 20rpx;
}

.time-picker {
  flex: 1;
  height: 80rpx;
  background: var(--bg-color, #f5f5f5);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-color, #333);
}

.error-tip {
  font-size: 26rpx;
  color: #d93025;
  margin-top: 20rpx;
}

.btn-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn {
  height: 90rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary {
  background: #0052d9;
  color: #fff;
}

.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header-actions {
  margin-bottom: 20rpx;
}

.template-list {
  margin-bottom: 100rpx;
}

.template-card {
  background: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.template-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.template-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.template-actions {
  display: flex;
  gap: 30rpx;
}

.action-text {
  font-size: 26rpx;
}

.edit-action {
  color: #0052d9;
}

.delete-action {
  color: #d93025;
}

.template-content {
  margin-bottom: 30rpx;
}

.content-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 15rpx;
}

.label {
  font-size: 26rpx;
  color: #666;
  min-width: 80rpx;
}

.value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.use-btn {
  width: 100%;
  background: #0052d9;
  color: white;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 30rpx;
}

.add-btn {
  position: fixed;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 90%;
  background: #0052d9;
  color: white;
  border-radius: 50rpx;
  font-size: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 82, 217, 0.3);
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 85%;
  max-height: 80vh;
  background: white;
  border-radius: 16rpx;
  z-index: 101;
  overflow: hidden;
}

.modal-header {
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border-bottom: 1rpx solid #eee;
}

.modal-body {
  padding: 30rpx;
}

.input, .textarea {
  width: 100%;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.input {
  min-height: 88rpx;
}

.textarea {
  min-height: 180rpx;
  line-height: 1.8;
}

.picker {
  padding: 20rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.modal-btn {
  flex: 1;
  border-radius: 0;
  font-size: 28rpx;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background: #0052d9;
  color: white;
}

.btn {
  background: #0052d9;
  color: white;
  border-radius: 8rpx;
  font-size: 28rpx;
}
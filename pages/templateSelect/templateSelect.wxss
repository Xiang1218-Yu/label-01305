.container {
  padding: 30rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header-hint {
  text-align: center;
  color: #666;
  font-size: 26rpx;
  margin-bottom: 30rpx;
}

.template-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.template-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.template-card:active {
  transform: scale(0.98);
  background: #f8f8f8;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.template-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0052d9 0%, #0066ff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.icon-text {
  color: white;
  font-size: 32rpx;
  font-weight: 600;
}

.header-content {
  flex: 1;
}

.template-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.template-meta {
  display: flex;
  gap: 16rpx;
}

.meta-priority, .meta-category {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
}

.meta-priority.priority-high {
  background: #fff3f0;
  color: #d93025;
}

.meta-priority.priority-normal {
  background: #fff9e6;
  color: #f5a623;
}

.meta-priority.priority-low {
  background: #e8f7ff;
  color: #007aff;
}

.meta-category {
  background: #f0f2f5;
  color: #666;
}

.card-body {
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.task-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.task-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.btn {
  border-radius: 50rpx;
  font-size: 28rpx;
}

.btn-primary {
  background: #0052d9;
  color: white;
}
<view class="container" data-theme="{{theme}}">
  <view class="card form-card">
    <view wx:if="{{!isEdit}}" class="template-import" bindtap="goToSelectTemplate">
      <text>从常用模板导入</text>
      <image class="arrow-icon" src="data:image/svg+xml;base64," mode="aspectFit" />
    </view>
    <view class="form-group">
      <view class="label">任务标题</view>
      <input class="input" placeholder="请输入任务标题" model:value="{{title}}" />
    </view>

    <view class="form-group">
      <view class="label">任务描述</view>
      <textarea class="textarea" placeholder="请输入任务描述..." model:value="{{desc}}" auto-height />
    </view>

    <view class="form-row">
      <view class="form-group half">
        <view class="label">优先级</view>
        <picker range="{{priorities}}" bindchange="bindPriorityChange" value="{{priorityIndex}}">
          <view class="picker-display">
            {{priorities[priorityIndex] || '请选择'}}
          </view>
        </picker>
      </view>

      <view class="form-group half">
        <view class="label">任务类型</view>
        <picker range="{{types}}" bindchange="bindTypeChange" value="{{typeIndex}}">
          <view class="picker-display">
            {{types[typeIndex] || '请选择'}}
          </view>
        </picker>
      </view>
    </view>

    <view class="form-group">
      <view class="label">开始时间</view>
      <picker mode="multiSelector" range="{{startDateTimeRange}}" value="{{startDateTimeIndex}}" bindchange="bindStartDateTimeChange">
        <view class="picker-display {{timeError ? 'error' : ''}}">{{startDateTime || '请选择开始时间'}}</view>
      </picker>
    </view>
    
    <view class="form-group">
      <view class="label">截止时间</view>
      <picker mode="multiSelector" range="{{endDateTimeRange}}" value="{{endDateTimeIndex}}" bindchange="bindEndDateTimeChange">
        <view class="picker-display {{timeError ? 'error' : ''}}">{{endDateTime || '请选择截止时间'}}</view>
      </picker>
      <view class="error-message" wx:if="{{timeError}}">{{timeError}}</view>
    </view>

    <view class="actions">
      <button class="btn btn-danger" wx:if="{{isEdit}}" bindtap="deleteTask">删除</button>
      <button class="btn btn-primary" bindtap="saveTask">保存任务</button>
    </view>
  </view>
</view>

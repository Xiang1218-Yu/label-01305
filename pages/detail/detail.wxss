.form-card {
  padding: 24px;
}

.form-group {
  margin-bottom: 20px;
}

.form-row {
  display: flex;
  justify-content: space-between;
}

.half {
  width: 48%;
}

.label {
  font-size: 14px;
  color: var(--text-sub);
  margin-bottom: 8px;
  display: block;
}

.input, .textarea, .picker-display {
  width: 100%;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 16px;
  background: var(--bg-color);
  box-sizing: border-box;
  min-height: 44px;
}

.picker-display {
  display: flex;
  align-items: center;
  min-height: 44px;
  color: var(--text-main);
}

.picker-display.error {
  border-color: var(--danger-color);
  color: var(--danger-color);
}

.error-message {
  font-size: 12px;
  color: var(--danger-color);
  margin-top: 4px;
  padding-left: 4px;
}

.textarea {
  min-height: 100px;
}

.actions {
  margin-top: 32px;
  display: flex;
  gap: 12px;
  justify-content: flex-end;
}

.actions button {
  flex: 1;
  max-width: 200px;
}

.actions button:only-child {
  max-width: 100%;
}

.template-import {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #f0f7ff;
  border-radius: 8rpx;
  margin-bottom: 30rpx;
  color: #0052d9;
  font-size: 28rpx;
}

.template-import .arrow-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
}

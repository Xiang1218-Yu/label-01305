.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: var(--bg-color, #f5f5f5);
}

.template-list {
  padding-bottom: 120rpx;
}

.template-card {
  background: var(--card-bg, #fff);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.template-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.template-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color, #333);
  flex: 1;
}

.template-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.use-btn {
  background: #0052d9;
  color: #fff;
}

.more-btn {
  background: var(--bg-color, #f5f5f5);
  color: var(--text-color, #333);
  font-weight: bold;
  padding: 12rpx 16rpx;
}

.template-info {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.info-tag {
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
}

.priority-tag {
  background: #e6f2ff;
  color: #0052d9;
}

.type-tag {
  background: #f0f0f0;
  color: #666;
}

.duration-tag {
  background: #e6f7ed;
  color: #52c41a;
}

.template-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
  margin-top: 12rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-top: 20rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #bbb;
  margin-top: 12rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: #0052d9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 82, 217, 0.4);
}

.fab-icon {
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
}

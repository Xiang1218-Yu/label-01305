.container {
  box-sizing: border-box;
  padding: 20px 16px 16px;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.title {
  font-size: 22px;
  font-weight: 600;
  color: var(--text-main);
}

.add-btn {
  background: var(--primary-color);
  color: #fff;
  border: none;
  border-radius: 20px;
  padding: 8px 16px;
  font-size: 14px;
  font-weight: 500;
  box-shadow: 0 4px 12px rgba(0, 82, 217, 0.25);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.add-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2px 8px rgba(0, 82, 217, 0.3);
}

.template-list {
  padding-bottom: 90px;
}

.template-item {
  background: var(--card-bg);
  border-radius: 16px;
  padding: 16px;
  margin-bottom: 14px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  border: 1px solid var(--border-color);
  display: flex;
  align-items: center;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  border-left: 4px solid var(--primary-color);
}

.template-item:active {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
}

.template-content {
  flex: 1;
}

.template-title {
  font-size: 16px;
  font-weight: 500;
  color: var(--text-main);
  margin-bottom: 8px;
  line-height: 1.4;
}

.template-desc {
  font-size: 14px;
  color: var(--text-sub);
  margin-bottom: 10px;
  line-height: 1.4;
  opacity: 0.8;
}

.template-meta {
  display: flex;
  gap: 16px;
  font-size: 12px;
  color: var(--text-sub);
  opacity: 0.7;
}

.template-actions {
  padding: 8px;
  cursor: pointer;
}

.action-icon {
  width: 20px;
  height: 20px;
  opacity: 0.5;
}

.empty-state {
  text-align: center;
  padding: 80px 24px;
  color: var(--text-sub);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.empty-icon {
  width: 64px;
  height: 64px;
  opacity: 0.4;
  margin-bottom: 8px;
}

.empty-desc {
  font-size: 13px;
  opacity: 0.6;
  line-height: 1.5;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: var(--card-bg);
  border-radius: 16px;
  padding: 24px;
  width: 80%;
  max-width: 300px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
}

.modal-title {
  font-size: 18px;
  font-weight: 600;
  color: var(--text-main);
  text-align: center;
  margin-bottom: 20px;
}

.modal-option {
  padding: 16px;
  border-radius: 12px;
  background: var(--bg-color);
  text-align: center;
  transition: all 0.25s;
}

.modal-option:active {
  background: rgba(0, 82, 217, 0.1);
  transform: scale(0.98);
}

.option-text {
  font-size: 15px;
  color: var(--primary-color);
  font-weight: 500;
}

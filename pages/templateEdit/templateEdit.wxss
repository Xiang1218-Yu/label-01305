.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: var(--bg-color, #f5f5f5);
}

.form {
  background: var(--card-bg, #fff);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: var(--text-color, #333);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: #d93025;
}

.input {
  height: 80rpx;
  background: var(--bg-color, #f5f5f5);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-color, #333);
}

.picker {
  height: 80rpx;
  background: var(--bg-color, #f5f5f5);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-color, #333);
  display: flex;
  align-items: center;
}

.textarea {
  height: 200rpx;
  background: var(--bg-color, #f5f5f5);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-color, #333);
  width: auto;
}

.btn-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn {
  height: 90rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary {
  background: #0052d9;
  color: #fff;
}

.btn-danger {
  background: #fff;
  color: #d93025;
  border: 2rpx solid #d93025;
}
